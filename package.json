{
  "name": "deskmudgin",
  "version": "0.1.0",
  "description": "A Mudgin who lives on your desktop. Top-layer companion, or back-layer icon-chewer.",
  "main": "out/main/main.js",
  "author": "Landon Sickler",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:web": "vite build",
    "build": "npm run build:main && npm run build:web",
    "start": "npm run build && node scripts/electron.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "npm run build && electron-builder --win --x64",
    "zh:draft": "node tools/zh-draft.mjs",
    "lang:export": "node tools/lang-export.mjs",
    "lang:ingest": "node tools/lang-ingest.mjs",
    "lang:build": "node tools/lang-build.mjs",
    "lang:selftest": "node tools/lang-selftest.mjs",
    "snap": "node tools/snap.mjs"
  },
  "dependencies": {
    "koffi": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "pinyin-pro": "^3.29.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.galanova.deskmudgin",
    "productName": "DeskMudgin",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
