{
  "name": "deskmudgin",
  "version": "0.1.0",
  "description": "A Mudgin who lives on your desktop. Top-layer companion, or back-layer icon-chewer.",
  "main": "out/main/main.js",
  "author": "Enriac Industries",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:web": "vite build",
    "build": "npm run build:main && npm run build:web",
    "start": "npm run build && node scripts/electron.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && npm run build && electron-builder --win --x64",
    "publish:update": "node --env-file-if-exists=.env tools/publish-update.mjs",
    "update:selftest": "node tools/updater-selftest.mjs",
    "zh:draft": "node tools/zh-draft.mjs",
    "lang:export": "node tools/lang-export.mjs",
    "lang:ingest": "node tools/lang-ingest.mjs",
    "lang:build": "node tools/lang-build.mjs",
    "lang:build-all": "node tools/lang-build-all.mjs",
    "lang:selftest": "node tools/lang-selftest.mjs",
    "snap": "node tools/snap.mjs",
    "make-icon": "npm run build:web && node tools/make-icon.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "koffi": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "pinyin-pro": "^3.29.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.enriacindustries.deskmudgin",
    "productName": "DeskMudgin",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "package.json",
      "!**/node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**",
      "!**/node_modules/koffi/build/koffi/win32_{arm64,ia32}/**",
      "!**/node_modules/koffi/{src,vendor,doc}/**"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DeskMudgin-Setup-${version}.exe",
      "shortcutName": "DeskMudgin",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "copyright": "Copyright © 2026 Enriac Industries",
    "publish": {
      "provider": "generic",
      "url": "https://updates.enriacindustries.com/deskmudgin/win/"
    }
  }
}
